# ==============================================================================
# HerHealth Universal Well-Being Companion — Environment Configuration Template
# Copy this file to .env: cp .env.example .env
# ==============================================================================

# Database
DATABASE_URL="file:./dev.db"

# Server
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Cloud AI API Keys (leave empty to use built-in offline clinical engine)
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Telemetry
NEXT_TELEMETRY_DISABLED=1
